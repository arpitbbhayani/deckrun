{
  "name": "deckrun",
  "version": "1.5.0",
  "description": "A local-first presentation tool for writing, editing, presenting, and exporting Markdown slides or self-contained HTML docs.",
  "type": "module",
  "bin": {
    "deckrun": "./dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "npm run build && tsx --test src/*.test.ts"
  },
  "dependencies": {
    "commander": "^11.1.0",
    "katex": "^0.18.4",
    "marked": "^9.1.6",
    "mermaid": "^11.17.2",
    "open": "^9.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.23.12",
    "typescript": "^5.3.3"
  }
}
